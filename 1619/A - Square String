void solve()
{
    string s;
    cin >> s;
    int n = s.size();
    if(n%2){
        cout << "NO
";
        return;
    }
    int m = n/2;
    string t = "", tt = "";
    for(int i=0;i<m;i++){
        t += s[i];
    }
    for(int i=m;i<n;i++){
        tt += s[i];
    }
    if(t == tt){
        cout << "YES
";
    }
    else{
        cout << "NO
";
    }
}
 
